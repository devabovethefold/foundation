---
import Head from '@landmarks/Head.astro'
import Footer from '@landmarks/Footer.astro'
import Header from '@landmarks/Header.astro'

interface Props {
  title: string
  description: string
}

const {title = 'Foundation', description = ''} = Astro.props
---

<html lang="en-US">
  <Head {title} {description} />
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
