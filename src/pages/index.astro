---
import Layout from '@layouts/Base.astro'

import {Image} from 'astro:assets'

const title = 'R2 Image Optimization Test'
const description = 'Starting with a solid base.'
---

<Layout {title} {description}>
  <section>
    <h2>Cloudflare Optimized</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <Image
        src="https://images.tryabovethefold.org/01KSXB591VARVRRVKFVDGYW4Z4.webp"
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
        inferSize={true}
        fetchpriority="high"
        loading="eager"
        alt="Optimized WebP"
        class="h-auto w-full object-cover"
      />
      <Image
        src="https://images.tryabovethefold.org/01KSXB61CR86XD8PC1GYQ7E3X1.jpg"
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
        inferSize={true}
        fetchpriority="high"
        loading="eager"
        quality={20}
        alt="Optimized JPG"
        class="h-auto w-full object-cover"
      />
      <Image
        src="https://images.tryabovethefold.org/01KSXB50J164JFTWRACN015NPE.png"
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
        inferSize={true}
        fetchpriority="high"
        loading="eager"
        alt="Optimized PNG"
        class="h-auto w-full object-cover"
      />
    </div>
  </section>
</Layout>
