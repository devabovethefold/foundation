---
import Layout from '@layouts/Base.astro'

import {Image} from 'astro:assets'

const title = 'R2 Image Optimization Test'
const description = 'Starting with a solid base.'
---

<Layout {title} {description}>
  <section>
    <h2>Cloudflare Optimized</h2>
    <Image
      src="https://images.tryabovethefold.org/01KSXB591VARVRRVKFVDGYW4Z4.webp"
      width={400}
      height={400}
      alt="Optimized WebP"
    />
    <Image
      src="https://images.tryabovethefold.org/01KSXB61CR86XD8PC1GYQ7E3X1.jpg"
      width={400}
      height={400}
      alt="Optimized JPG"
    />
    <Image
      src="https://images.tryabovethefold.org/01KSXB50J164JFTWRACN015NPE.png"
      width={400}
      height={400}
      alt="Optimized PNG"
    />
  </section>
</Layout>
