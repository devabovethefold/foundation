---
import Layout from '@layouts/Base.astro'
import { BRAND_BASE } from '@utilities/themes/colors'

const coreSteps = ['100', '200', '300', '400', '500', '600', '700', '800', '900']
const lightSurfaceSteps = ['50']
const darkSurfaceSteps = ['950']

const scales = [
  { name: 'Primary', title: 'Primary', key: 'base' },
  { name: 'Success', title: 'Success', key: 'success' },
  { name: 'Info', title: 'Info', key: 'info' },
  { name: 'Warning', title: 'Warning', key: 'warning' },
  { name: 'Danger', title: 'Danger', key: 'error' },
  { name: 'Accent', title: 'Accent', key: 'accent' },
  { name: 'Neutral', title: 'Neutral', key: 'neutral' },
]

const title = 'System Color Palette'
const description = 'Dynamic OKLCH color palette generator and previewer'
---

<script>
  import { oklch, formatHex, parse } from 'culori'
  import Alpine from 'alpinejs'

  function getSemanticBases(brandBaseHex: string) {
    const origBase = oklch(parse(brandBaseHex)) as any
    const origBaseL = origBase.l ?? 0.5
    const origBaseC = origBase.c ?? 0
    const origBaseH = origBase.h ?? 0

    // Dynamic config read from CSS custom properties, falling back to safe defaults
    const getCSSProp = (name: string, fallback: number) => {
      if (typeof window === 'undefined') return fallback
      const val = getComputedStyle(document.documentElement).getPropertyValue(name).trim()
      return val ? parseFloat(val) : fallback
    }

    const chromaMin = getCSSProp('--palette-chroma-min', 0.14)
    const chromaMax = getCSSProp('--palette-chroma-max', 0.22)
    const lightnessMin = getCSSProp('--base-lightness-min', 0.30)
    const lightnessMax = getCSSProp('--base-lightness-max', 0.70)

    const baseL = Math.max(lightnessMin, Math.min(origBaseL, lightnessMax))
    const baseC = Math.max(chromaMin, Math.min(origBaseC, chromaMax))
    const baseH = origBaseH

    const base = { mode: 'oklch', l: baseL, c: baseC, h: baseH }

    const accentL = Math.max(0.6, Math.min(baseL + 0.1, 0.85))
    const accentC = Math.max(baseC, 0.16)
    const accentH = (baseH + 180) % 360

    return {
      base,
      accent: {
        mode: 'oklch',
        l: accentL,
        c: accentC,
        h: accentH
      },
      success: {
        mode: 'oklch',
        l: Math.max(0.6, Math.min(baseL + 0.25, 0.8)),
        c: 0.18,
        h: 143
      },
      info: {
        mode: 'oklch',
        l: Math.max(0.58, Math.min(baseL + 0.25, 0.78)),
        c: 0.16,
        h: 226
      },
      warning: {
        mode: 'oklch',
        l: Math.max(0.68, Math.min(baseL + 0.35, 0.88)),
        c: 0.2,
        h: 75
      },
      error: {
        mode: 'oklch',
        l: Math.max(0.55, Math.min(baseL + 0.2, 0.75)),
        c: 0.22,
        h: 25
      },
      neutral: {
        mode: 'oklch',
        l: Math.max(0.48, Math.min(baseL + 0.15, 0.62)),
        c: 0.03,
        h: baseH
      }
    }
  }

  function generateScale(target: any) {
    const steps = [100, 200, 300, 400, 500, 600, 700, 800, 900]
    const scale: Record<string, string> = {}

    const l = target.l ?? 0.5
    const c = target.c ?? 0
    const h = target.h ?? 0

    const L_max = Math.max(0.95, Math.min(l + (1.0 - l) * 0.9, 0.98))
    const L_min = Math.max(0.04, Math.min(l * 0.25, 0.15))

    steps.forEach((step) => {
      let result: any

      switch (step) {
        case 100:
          result = { mode: 'oklch', l: L_max, c: c * 0.3, h }
          break
        case 200:
          result = { mode: 'oklch', l: L_max * 0.8671875 + l * 0.15625 - L_min * 0.0234375, c: c * 0.475, h }
          break
        case 300:
          result = { mode: 'oklch', l: L_max * 0.5625 + l * 0.5 - L_min * 0.0625, c: c * 0.65, h }
          break
        case 400:
          result = { mode: 'oklch', l: L_max * 0.2265625 + l * 0.84375 - L_min * 0.0703125, c: c * 0.825, h }
          break
        case 500:
          result = { mode: 'oklch', l, c, h }
          break
        case 600:
          result = { mode: 'oklch', l: -L_max * 0.0703125 + l * 0.84375 + L_min * 0.2265625, c: c * 0.835, h }
          break
        case 700:
          result = { mode: 'oklch', l: -L_max * 0.0625 + l * 0.5 + L_min * 0.5625, c: c * 0.67, h }
          break
        case 800:
          result = { mode: 'oklch', l: -L_max * 0.0234375 + l * 0.15625 + L_min * 0.8671875, c: c * 0.505, h }
          break
        case 900:
          result = { mode: 'oklch', l: L_min, c: c * 0.34, h }
          break
        default:
          result = { mode: 'oklch', l, c, h }
      }

      scale[step.toString()] = formatHex(result) || '#000000'
    })

    return scale
  }

  // Generate surface steps
  function generateSurface(target: any, type: 'light' | 'dark') {
    const steps = type === 'light' ? ['50'] : ['950']
    const scale: Record<string, string> = {}
    
    const l = target.l ?? 0.5
    const c = target.c ?? 0
    const h = target.h ?? 0

    const L_max = Math.max(0.95, Math.min(l + (1.0 - l) * 0.9, 0.98))
    const L_min = Math.max(0.04, Math.min(l * 0.25, 0.15))

    steps.forEach(step => {
      let resL: number
      switch(step) {
        case '50': resL = L_max + (1.0 - L_max) * 0.5; break
        case '950': resL = L_min * 0.5; break
        default: resL = l
      }
      scale[step] = formatHex({ mode: 'oklch', l: resL, c: c * 0.1, h }) || '#000000'
    })
    return scale
  }

  const initPaletteOnDOM = () => {
    const activeAlpine = (window as any).Alpine
    if (!activeAlpine || !activeAlpine.$persist) {
      setTimeout(initPaletteOnDOM, 10)
      return
    }

    const container = document.getElementById('palette-container')
    if (container && !container.hasAttribute('x-data')) {
      activeAlpine.data('palette', () => ({
        brandBase: activeAlpine.$persist(
          container.dataset.brandBase || '#195230'
        ).as('brandColor'),
        allScales: {},
        toastMessage: '',
        showToast: false,
        
        init() {
          this.$watch('brandBase', () => this.updateScales())
          this.updateScales()
        },

        updateScales() {
          if (!this.brandBase || !this.brandBase.startsWith('#') || this.brandBase.length !== 7) return
          const bases = getSemanticBases(this.brandBase)
          const newScales = {}
          
          Object.keys(bases).forEach(key => {
            newScales[key] = {
              core: generateScale(bases[key]),
              light: generateSurface(bases[key], 'light'),
              dark: generateSurface(bases[key], 'dark')
            }
          })
          this.allScales = newScales
        },

        copyToClipboard(colorText) {
          navigator.clipboard.writeText(colorText).then(() => {
            this.toastMessage = `Copied ${colorText} to clipboard!`
            this.showToast = true
            setTimeout(() => {
              this.showToast = false
            }, 2000)
          }).catch(() => {
            this.toastMessage = 'Failed to copy'
            this.showToast = true
            setTimeout(() => {
              this.showToast = false
            }, 2000)
          })
        }
      }))

      container.setAttribute('x-data', 'palette')
      activeAlpine.initTree(container)
    }
  }

  // Initialize immediately
  initPaletteOnDOM()

  // Fallback for DOMContentLoaded
  document.addEventListener('DOMContentLoaded', initPaletteOnDOM)

  // Support Astro View Transitions
  document.addEventListener('astro:page-load', initPaletteOnDOM)
</script>

<Layout {title} {description}>
  <div
    id="palette-container"
    class="min-h-screen bg-slate-50/50 p-6 md:p-12"
    data-brand-base={BRAND_BASE}
  >
    
    <!-- Top Level Wrapper: Allows columns to flow in a row on desktop and wrap on small screens -->
    <div class="mx-auto flex max-w-[120rem] flex-wrap justify-between gap-12 xl:flex-nowrap xl:gap-16">
      
      <div class="flex flex-col gap-6 xl:w-72 xl:shrink-0">
        <div class="flex items-center justify-between border-b-2 border-slate-200 pb-4">
          <div class="flex items-center gap-3">
            <div class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-300 bg-white text-sm font-bold text-slate-800">1</div>
            <h2 class="text-lg font-bold tracking-tight text-slate-800">Brand Color</h2>
          </div>
          <div class="flex items-center gap-2">
            <input 
              type="color" 
              x-model="brandBase" 
              class="h-8 w-8 cursor-pointer rounded border-0 bg-transparent p-0"
            />
            <input 
              type="text" 
              x-model="brandBase" 
              class="w-20 rounded border border-slate-200 bg-white px-2 py-1 font-mono text-[10px] font-bold uppercase text-slate-600 focus:border-base-hi focus:outline-none"
              placeholder="#000000"
            />
          </div>
        </div>
        <div class="grid grid-cols-1 gap-8">
          <div class="flex flex-col gap-4">
            <div class="fade slide-up flex items-center justify-between rounded-xl border border-slate-100 bg-white p-3 shadow-sm cursor-pointer hover:bg-slate-50 transition-colors" x-show="allScales.base" @click="copyToClipboard(allScales.base?.core['500'])">
              <div class="flex flex-col">
                <span class="text-[0.65rem] font-bold tracking-wider text-slate-400 uppercase">Primary</span>
                <div class="mt-1 flex items-center gap-2">
                  <div class="h-6 w-6 rounded shadow-inner transition-colors duration-500" x-bind:style="allScales.base ? 'background-color: ' + allScales.base.core['500'] : ''"></div>
                  <code class="font-mono text-sm font-bold text-slate-800" x-text="allScales.base?.core['500']"></code>
                </div>
              </div>
            </div>
             <div class="stagger flex flex-col overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm">
               {coreSteps.map((step) => {
                 const isDark = parseInt(step) >= 500;
                 return (
                    <div 
                      class={`fade slide-up stagger-item group flex h-[3.25rem] w-full cursor-pointer items-center justify-between px-4 transition-all duration-500 hover:z-10 hover:scale-[1.02] hover:shadow-md ${isDark ? 'text-white' : 'text-slate-800'}`} 
                      x-show="allScales.base"
                      x-bind:style={`allScales.base ? 'background-color: ' + allScales.base.core['${step}'] : ''`}
                      @click={`copyToClipboard(allScales.base.core['${step}'])`}
                    >
                      <span class="w-8 text-xs font-bold opacity-60">{step}</span>
                      <span class="font-mono text-xs font-semibold tracking-wider opacity-0 transition-opacity group-hover:opacity-100" x-text={`allScales.base?.core['${step}']`}></span>
                    </div>
                 );
               })}
             </div>
             <div class="stagger mt-2 flex gap-2">
               <div class="flex flex-1 flex-col overflow-hidden rounded-lg border border-slate-100 shadow-sm opacity-90">
                 {lightSurfaceSteps.map(step => (
                    <div 
                      class="fade slide-up stagger-item flex h-8 w-full items-center justify-center cursor-pointer transition-all duration-500 hover:z-10 hover:scale-105 hover:shadow-md" 
                      x-show="allScales.base"
                      x-bind:style={`allScales.base ? 'background-color: ' + allScales.base.light['${step}'] : ''`}
                      @click={`copyToClipboard(allScales.base.light['${step}'])`}
                    >
                      <span class="text-[0.6rem] font-bold opacity-60">{step}</span>
                    </div>
                 ))}
               </div>
               <div class="flex flex-1 flex-col overflow-hidden rounded-lg border border-slate-100 shadow-sm opacity-90">
                   {darkSurfaceSteps.map(step => (
                    <div 
                      class="fade slide-up stagger-item flex h-8 w-full items-center justify-center cursor-pointer transition-all duration-500 hover:z-10 hover:scale-105 hover:shadow-md text-white" 
                      x-show="allScales.base"
                      x-bind:style={`allScales.base ? 'background-color: ' + allScales.base.dark['${step}'] : ''`}
                      @click={`copyToClipboard(allScales.base.dark['${step}'])`}
                    >
                      <span class="text-[0.6rem] font-bold opacity-60">{step}</span>
                    </div>
                 ))}
               </div>
             </div>
          </div>
        </div>
      </div>
      <div class="flex flex-1 flex-col gap-6">
        <!-- Header -->
        <div class="flex items-center gap-3 border-b-2 border-slate-200 pb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-300 bg-white text-sm font-bold text-slate-800">2</div>
          <h2 class="text-lg font-bold tracking-tight text-slate-800">Semantic Colors</h2>
        </div>
        <!-- Column Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 max-xl:gap-8 lg:grid-cols-4 xl:gap-6">
          {['success', 'info', 'warning', 'error'].map(key => (
            <div class="flex flex-col gap-4">
              <!-- Top Card Preview -->
              <div class="fade slide-up flex items-center justify-between rounded-xl border border-slate-100 bg-white p-3 shadow-sm cursor-pointer hover:bg-slate-50 transition-colors" x-show={"allScales['" + key + "']"} @click={`copyToClipboard(allScales['${key}']?.core['500'])`}>
                <div class="flex flex-col">
                  <span class="text-[0.65rem] font-bold tracking-wider text-slate-400 capitalize" x-text={`'${key}'`}></span>
                  <div class="mt-1 flex items-center gap-2">
                    <div class="h-6 w-6 rounded shadow-inner transition-colors duration-500" x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].core['500'] : ''`}></div>
                    <code class="font-mono text-sm font-bold text-slate-800" x-text={"allScales['" + key + "']?.core['500']"}></code>
                  </div>
                </div>
              </div>
               <div class="stagger flex flex-col overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm" x-show={"allScales['" + key + "']"}>
                 {coreSteps.map(step => {
                   const isDark = parseInt(step) >= 500;
                   return (
                      <div 
                        class={`fade slide-up stagger-item group flex h-[3.25rem] w-full cursor-pointer items-center justify-between px-4 transition-all duration-500 hover:z-10 hover:scale-[1.02] hover:shadow-md ${isDark ? 'text-white' : 'text-slate-800'}`} 
                        x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].core['${step}'] : ''`}
                        @click={`copyToClipboard(allScales['${key}'].core['${step}'])`}
                      >
                        <span class="w-8 text-xs font-bold opacity-60">{step}</span>
                        <span class="font-mono text-xs font-semibold tracking-wider opacity-0 transition-opacity group-hover:opacity-100" x-text={"allScales['" + key + "']?.core['" + step + "']"}></span>
                      </div>
                   );
                 })}
               </div>
               <div class="stagger mt-2 flex gap-2" x-show={"allScales['" + key + "']"}>
                 <div class="flex flex-1 flex-col overflow-hidden rounded-lg border border-slate-100 shadow-sm opacity-90">
                   {lightSurfaceSteps.map(step => (
                      <div 
                        class="fade slide-up stagger-item flex h-8 w-full items-center justify-center cursor-pointer transition-all duration-500 hover:z-10 hover:scale-105 hover:shadow-md" 
                        x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].light['${step}'] : ''`}
                        @click={`copyToClipboard(allScales['${key}'].light['${step}'])`}
                      >
                        <span class="text-[0.6rem] font-bold opacity-60">{step}</span>
                      </div>
                   ))}
                 </div>
                 <div class="flex flex-1 flex-col overflow-hidden rounded-lg border border-slate-100 shadow-sm opacity-90">
                     {darkSurfaceSteps.map(step => (
                      <div 
                        class="fade slide-up stagger-item flex h-8 w-full items-center justify-center cursor-pointer transition-all duration-500 hover:z-10 hover:scale-105 hover:shadow-md text-white" 
                        x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].dark['${step}'] : ''`}
                        @click={`copyToClipboard(allScales['${key}'].dark['${step}'])`}
                      >
                        <span class="text-[0.6rem] font-bold opacity-60">{step}</span>
                      </div>
                   ))}
                 </div>
               </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 3. Support Colors Group -->
      <div class="flex flex-col gap-6 xl:w-[28rem] xl:shrink-0">
        <!-- Header -->
        <div class="flex items-center gap-3 border-b-2 border-slate-200 pb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-300 bg-white text-sm font-bold text-slate-800">3</div>
          <h2 class="text-lg font-bold tracking-tight text-slate-800">Support Colors</h2>
        </div>
        <!-- Column Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 max-xl:gap-8 xl:gap-6">
          {['accent', 'neutral'].map(key => (
            <div class="flex flex-col gap-4">
              <!-- Top Card Preview -->
              <div class="fade slide-up flex items-center justify-between rounded-xl border border-slate-100 bg-white p-3 shadow-sm cursor-pointer hover:bg-slate-50 transition-colors" x-show={"allScales['" + key + "']"} @click={`copyToClipboard(allScales['${key}']?.core['500'])`}>
                <div class="flex flex-col">
                  <span class="text-[0.65rem] font-bold tracking-wider text-slate-400 capitalize" x-text={`'${key}'`}></span>
                  <div class="mt-1 flex items-center gap-2">
                    <div class="h-6 w-6 rounded shadow-inner transition-colors duration-500" x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].core['500'] : ''`}></div>
                    <code class="font-mono text-sm font-bold text-slate-800" x-text={"allScales['" + key + "']?.core['500']"}></code>
                  </div>
                </div>
              </div>

               <!-- Core Scale -->
               <div class="stagger flex flex-col overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm" x-show={"allScales['" + key + "']"}>
                 {coreSteps.map(step => {
                   const isDark = parseInt(step) >= 500;
                   return (
                      <div 
                        class={`fade slide-up stagger-item group flex h-[3.25rem] w-full cursor-pointer items-center justify-between px-4 transition-all duration-500 hover:z-10 hover:scale-[1.02] hover:shadow-md ${isDark ? 'text-white' : 'text-slate-800'}`} 
                        x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].core['${step}'] : ''`}
                        @click={`copyToClipboard(allScales['${key}'].core['${step}'])`}
                      >
                        <span class="w-8 text-xs font-bold opacity-60">{step}</span>
                        <span class="font-mono text-xs font-semibold tracking-wider opacity-0 transition-opacity group-hover:opacity-100" x-text={"allScales['" + key + "']?.core['" + step + "']"}></span>
                      </div>
                   );
                 })}
               </div>

               <!-- Surfaces -->
               <div class="stagger mt-2 flex gap-2" x-show={"allScales['" + key + "']"}>
                 <div class="flex flex-1 flex-col overflow-hidden rounded-lg border border-slate-100 shadow-sm opacity-90">
                   {lightSurfaceSteps.map(step => (
                      <div 
                        class="fade slide-up stagger-item flex h-8 w-full items-center justify-center cursor-pointer transition-all duration-500 hover:z-10 hover:scale-105 hover:shadow-md text-slate-800" 
                        x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].light['${step}'] : ''`}
                        @click={`copyToClipboard(allScales['${key}'].light['${step}'])`}
                      >
                        <span class="text-[0.6rem] font-bold opacity-60">{step}</span>
                      </div>
                   ))}
                 </div>
                 <div class="flex flex-1 flex-col overflow-hidden rounded-lg border border-slate-100 shadow-sm opacity-90">
                     {darkSurfaceSteps.map(step => (
                      <div 
                        class="fade slide-up stagger-item flex h-8 w-full items-center justify-center cursor-pointer transition-all duration-500 hover:z-10 hover:scale-105 hover:shadow-md text-white" 
                        x-bind:style={`allScales['${key}'] ? 'background-color: ' + allScales['${key}'].dark['${step}'] : ''`}
                        @click={`copyToClipboard(allScales['${key}'].dark['${step}'])`}
                      >
                        <span class="text-[0.6rem] font-bold opacity-60">{step}</span>
                      </div>
                   ))}
                 </div>
               </div>
            </div>
          ))}
        </div>
      </div>
      
    </div>

    <!-- Toast Notification -->
    <div
      class="fixed bottom-6 right-6 z-50 rounded-xl bg-slate-900 px-4 py-3 text-xs font-semibold text-white shadow-lg transition-all duration-300"
      x-show="showToast"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-2"
      x-text="toastMessage"
    >
    </div>
  </div>
</Layout>
